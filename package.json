{
  "name": "etail-depot-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node tools/run-with-database.mjs vitest run tests/integration",
    "test:concurrency": "node tools/run-with-database.mjs vitest run tests/concurrency",
    "test:contracts": "vitest run tests/contracts",
    "test:architecture": "node tools/verify-architecture.mjs",
    "test:api": "node tools/run-with-database.mjs playwright test --project=api",
    "test:e2e": "node tools/run-with-database.mjs playwright test --project=desktop --project=mobile",
    "test:a11y": "node tools/run-with-database.mjs playwright test --project=accessibility",
    "test:security": "node tools/verify-security.mjs && pnpm audit --audit-level=high",
    "db:start": "node tools/postgres-runtime.mjs start",
    "db:stop": "node tools/postgres-runtime.mjs stop",
    "db:migrate": "tsx tools/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:concurrency && pnpm test:contracts && pnpm test:architecture && pnpm build && pnpm test:api && pnpm test:e2e && pnpm test:a11y && pnpm test:security",
    "db:serve": "node tools/postgres-runtime.mjs serve",
    "preview:fixture": "node tools/run-with-database.mjs --preview next start --hostname 127.0.0.1 --port 3100",
    "contracts:generate": "node --import tsx tools/generate-openapi.ts",
    "test:handoff": "python3 tools/test-handoff.py"
  },
  "dependencies": {
    "@netlify/database": "2.0.1",
    "@netlify/functions": "6.0.0",
    "@netlify/identity": "2.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.3.4",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@axe-core/playwright": "4.13.0",
    "@netlify/plugin-nextjs": "5.15.13",
    "@opentelemetry/api": "1.9.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "netlify-cli": "27.5.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
