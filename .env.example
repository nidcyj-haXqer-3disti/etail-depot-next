# Server-only configuration. Never put tokens or connection credentials in Git.
APP_ENV=local
APP_MODE=sandbox
ENABLE_REAL_MONEY=false
ETAIL_PUBLIC_ORIGIN=http://127.0.0.1:3000
ENABLE_LOCAL_FIXTURE_IDENTITY=false
ENABLE_SANDBOX_SIMULATOR=false
SIMULATION_RUNNER_ENABLED=false
FINANCIAL_SCHEDULES_ENABLED=false
ALLOW_DEMO_IMPERSONATION=false
# NETLIFY_DB_URL and NETLIFY_DB_DRIVER come from the runtime or isolated local test harness.
