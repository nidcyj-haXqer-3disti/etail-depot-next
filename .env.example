# Public website only. No database, authentication or payment credentials are needed.
# Canonical site and approved product links are source-controlled public settings.
# The D122 approved search release applies only to the recorded Netlify production site.
# Local and preview environments stay noindex. Never copy production release markers here.
# Production builds/functions require APP_ENV=production, ETAIL_SEARCH_CONTEXT=production,
# the recorded SITE_ID and ETAIL_PUBLIC_ORIGIN, and NODE_ENV=production.
# CONTEXT must be production when supplied; it is absent in Netlify Functions.
APP_ENV=local
NEXT_TELEMETRY_DISABLED=1
