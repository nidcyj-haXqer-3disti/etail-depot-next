# TEMPLATE ONLY; copy for local development after implementing validated config.
# No production/customer secrets. Never commit a populated .env file.
APP_MODE=sandbox
ENABLE_REAL_MONEY=false
PAYFAC_PROVIDER=mock
ISSUER_PROVIDER=mock
ALLOW_DEMO_IMPERSONATION=false
ENABLE_SANDBOX_SIMULATOR=false
SIMULATION_RUNNER_ENABLED=false
FINANCIAL_SCHEDULES_ENABLED=false
# Provision only a NEW service. Never reuse old Etail Depot endpoints or keys.
ETAIL_PUBLIC_ORIGIN=
NETLIFY_IDENTITY_URL=
# Only if the chosen SINGLE session model needs application encryption.
SESSION_ENCRYPTION_KEY=
PAYFAC_WEBHOOK_SECRET=
ISSUER_WEBHOOK_SECRET=
SIMULATION_RUNNER_SECRET=
# Netlify Database binds hosted DB branches automatically; no old URL here.
# Local test database overrides must be explicitly opted in and loopback-only.
ETAIL_LOCAL_DATABASE_URL=
ETAIL_ALLOW_LOCAL_MIGRATIONS=false
