# Disabled template. Implement real commands before copying under .github/workflows.
# Replace every PIN_* with a verified immutable action SHA. This template cannot run as-is.
name: Verify application
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
concurrency:
  group: verify-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    services:
      postgres:
        image: postgres:17 # Verify/pin supported image in M0; no production database.
        env:
          POSTGRES_USER: etail_ci
          POSTGRES_PASSWORD: disposable-ci-password
          POSTGRES_DB: etail_next_test
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U etail_ci -d etail_next_test"
          --health-interval 10s --health-timeout 5s --health-retries 5
    env:
      APP_MODE: sandbox
      ENABLE_REAL_MONEY: 'false'
      PAYFAC_PROVIDER: mock
      ISSUER_PROVIDER: mock
      ALLOW_DEMO_IMPERSONATION: 'false'
      # Implement isolated fixture auth with explicit test-only construction.
      ENABLE_SANDBOX_SIMULATOR: 'true'
      SIMULATION_RUNNER_ENABLED: 'true'
      FINANCIAL_SCHEDULES_ENABLED: 'false'
      ETAIL_ALLOW_LOCAL_MIGRATIONS: 'true'
      ETAIL_LOCAL_DATABASE_URL: postgresql://etail_ci:disposable-ci-password@127.0.0.1:5432/etail_next_test
      NEXT_TELEMETRY_DISABLED: '1'
    steps:
      - uses: actions/checkout@PIN_CHECKOUT_SHA
        with:
          persist-credentials: false
      - uses: pnpm/action-setup@PIN_PNPM_SETUP_SHA
      - uses: actions/setup-node@PIN_SETUP_NODE_SHA
        with:
          node-version-file: .nvmrc
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm exec playwright install --with-deps chromium
      - run: pnpm verify
      # verify must implement real lint/types/unit/PG/API/concurrency/architecture/
      # contracts/security/build/browser checks; seed only fictional test data.
      - name: Preserve evidence even after failure
        if: always()
        uses: actions/upload-artifact@PIN_UPLOAD_ARTIFACT_SHA
        with:
          name: evidence-${{ github.sha }}
          path: test-results/
          retention-days: 14
          if-no-files-found: error
# Deployment is NOT coupled to this PR workflow. Never provide live secrets to forks.
